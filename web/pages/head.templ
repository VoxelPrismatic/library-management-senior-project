package common

templ Head(title string, desc string) {
	<!DOCTYPE html>
	<head>
		<meta charset="utf-8"/>
		<link rel="icon" href="/assets/favicon.ico"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="description" content={ desc }/>
		<title>{ title }</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/madeonawave/semtx@latest/semtx.css"/>
		<script type="text/javascript" src="/assets/js/htmx-2.0.8.js"></script>
		<style>
			.app {
				display: flex;
				flex-direction: column;
				height: 100vh;
				max-width: 980px;
				margin: 0 auto;
				box-shadow: 0 0 40px rgba(0,0,0,0.15);
			}

			.body-row {
				display: flex;
				flex: 1;
				overflow: hidden;
			}

			aside.sidebar {
				width: 105px;
				flex-shrink: 0;
				overflow-y: auto;
				padding: 1rem 0;
				background: var(--bg-surface);
				border-right: 1px solid var(--bg-mantle);
			}

			aside.sidebar nav {
				display: flex;
				flex-direction: column;
				padding: 0;
				gap: 0;
			}

			aside.sidebar nav a {
				display: block;
				padding: 3px 14px;
				font-size: 0.82rem;
				color: var(--text);
				text-decoration: none;
				background: none;
				border-radius: 0;
			}

			aside.sidebar nav a:hover {
				background: none;
				text-decoration: underline;
			}

			aside.sidebar nav a.active {
				font-weight: 600;
				background: none;
			}

			aside.sidebar nav hr {
				border: none;
				margin: 1.2rem 0;
			}

			main {
				flex: 1;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
			}

			#view-catalog { display: flex; flex-direction: column; flex: 1; }
			#view-add     { display: none; flex-direction: column; flex: 1; }

			.catalog-toolbar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.6rem 1rem;
				border-bottom: 1px solid var(--bg-mantle);
				background: var(--bg-surface);
			}

			.catalog-title {
				flex: 1;
				font-weight: 600;
				font-size: 0.95rem;
			}

			.alpha-strip {
				display: flex;
				flex-wrap: wrap;
				padding: 0.3rem 1rem;
				gap: 0;
				border-bottom: 1px solid var(--bg-mantle);
				background: var(--bg-surface);
			}

			.alpha-strip a {
				display: inline-block;
				min-width: 20px;
				text-align: center;
				font-size: 0.7rem;
				color: var(--text);
				text-decoration: none;
				padding: 2px 3px;
				border-radius: 3px;
				opacity: 0.5;
			}

			.alpha-strip a:hover,
			.alpha-strip a.active {
				background: var(--primary);
				color: #fff;
				opacity: 1;
			}

			.catalog-content {
				padding: 1rem 1.2rem 2rem;
				flex: 1;
				overflow-y: auto;
			}

			.alpha-section { margin-bottom: 1.5rem; }

			.alpha-section h2 {
				font-size: 1.25rem;
				font-weight: 600;
				margin-bottom: 0.75rem;
			}

			.books-row {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			article.book-thumb {
				display: flex;
				flex-direction: column;
				width: 110px;
				cursor: pointer;
			}

			.book-cover {
				width: 110px;
				height: 154px;
				border-radius: 3px;
				overflow: hidden;
				background: var(--bg-mantle);
				border: 1px solid var(--bg-mantle);
				margin-bottom: 0.4rem;
				transition: box-shadow 0.15s;
			}

			article.book-thumb:hover .book-cover {
				box-shadow: 0 4px 14px rgba(0,0,0,0.2);
			}

			.book-cover img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.book-cover-placeholder {
				width: 100%;
				height: 100%;
				display: none;
				align-items: center;
				justify-content: center;
				padding: 8px;
				font-size: 0.7rem;
				font-weight: 500;
				text-align: center;
				color: var(--text);
				opacity: 0.5;
				line-height: 1.4;
			}

			.book-label {
				font-size: 0.7rem;
				line-height: 1.4;
			}

			.copy-count { opacity: 0.5; }

			.add-panel {
				margin: 1.2rem;
				flex: 1;
			}

			.add-panel h1 {
				font-size: 1.25rem;
				font-weight: 600;
				margin-bottom: 1rem;
			}

			.results-heading {
				font-size: 1.05rem;
				font-weight: 600;
				margin-bottom: 0.75rem;
			}

			.results-grid {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.home-bar {
				display: flex;
				justify-content: flex-end;
				padding: 0.5rem 1rem;
				border-top: 1px solid var(--bg-mantle);
				background: var(--bg-surface);
				margin-top: auto;
			}

			.home-bar a { opacity: 0.5; }
			.home-bar a:hover { opacity: 1; }

			.sr-only {
				position: absolute;
				width: 1px; height: 1px;
				clip: rect(0,0,0,0);
				overflow: hidden;
			}
		</style>
	</head>
}
